use crate::events::types::{FocusGained, FocusLost, KeyPress, MouseScroll};
use crate::layout::Size;
use crate::ui::TimerHandle;
use crate::widget::{Canvas, Widget, WidgetHandle};
use crate::{Key, Ui};
use bento_wgpu::{RectDraw, TextAlign, TextDraw, TextMeasurer};
use cosmic_text::{Action, Attrs, Buffer, Edit, Editor, Metrics, Motion, Shaping, Weight};

pub struct MultilineInput {
    pub x: f32,
    pub y: f32,
    pub w: f32,
    pub h: f32,
    pub width: Size,
    pub height: Size,
    pub color: [f32; 4],
    pub background: [f32; 4],
    pub font_size: f32,
    pub line_height: f32,
    pub padding: f32,
    pub z: i32,
    focused: bool,
    cursor_visible: bool,
    blink_handle: Option<TimerHandle>,
    scroll_y: f32,
    editor: Editor<'static>,
    pending_keys: Vec<KeyPress>,
    // cached after each update for rendering
    cursor_x: f32,
    cursor_visual_row: usize,
    total_visual_rows: usize,
    initialized: bool,
}

impl MultilineInput {
    pub fn new() -> Self {
        let buffer = Buffer::new_empty(Metrics::new(14.0, 20.0));
        let editor = Editor::new(buffer);
        Self {
            x: 0.0,
            y: 0.0,
            w: 400.0,
            h: 300.0,
            width: Size::Fixed(400.0),
            height: Size::Fixed(300.0),
            color: [1.0, 1.0, 1.0, 1.0],
            background: [0.15, 0.15, 0.15, 1.0],
            font_size: 14.0,
            line_height: 20.0,
            padding: 8.0,
            z: 0,
            focused: false,
            cursor_visible: true,
            blink_handle: None,
            scroll_y: 0.0,
            editor,
            pending_keys: Vec::new(),
            cursor_x: 0.0,
            cursor_visual_row: 0,
            total_visual_rows: 1,
            initialized: false,
        }
    }

    pub fn text(&self) -> String {
        let mut result = String::new();
        self.editor.with_buffer(|b| {
            for (i, line) in b.lines.iter().enumerate() {
                if i > 0 {
                    result.push('\n');
                }
                result.push_str(line.text());
            }
        });
        result
    }
}

fn blink_tick_multi(ui: &mut Ui, handle: WidgetHandle<MultilineInput>) {
    let h = ui.asyncs.timer(0.53, move |ui| {
        if let Some(input) = ui.get_mut_internal(handle) {
            if input.focused {
                input.cursor_visible = !input.cursor_visible;
                ui.needs_redraw = true;
                blink_tick_multi(ui, handle);
            }
        }
    });
    if let Some(input) = ui.get_mut_internal(handle) {
        input.blink_handle = Some(h);
    }
}

impl Widget for MultilineInput {
    fn name(&self) -> &str {
        "MultilineInput"
    }

    fn build(&mut self, ui: &mut Ui, handle: WidgetHandle<()>) {
        let handle = handle.typed::<MultilineInput>();

        ui.listen(handle, move |e: &FocusGained, ui: &mut Ui| {
            if let Some(input) = ui.get_mut_internal(handle) {
                input.focused = true;
                input.cursor_visible = true;
            }
            blink_tick_multi(ui, handle);
        });

        ui.listen(handle, move |e: &FocusLost, ui: &mut Ui| {
            if let Some(input) = ui.get_mut_internal(handle) {
                input.focused = false;
                input.cursor_visible = true;
                if let Some(h) = input.blink_handle.take() {
                    h.cancel();
                }
            }
        });

        // store keys, process in update() where we have font_system access
        ui.listen(handle, move |e: &KeyPress, ui: &mut Ui| {
            if let Some(input) = ui.get_mut_internal(handle) {
                input.pending_keys.push(*e);
                input.cursor_visible = true;
                if let Some(h) = input.blink_handle.take() {
                    h.cancel();
                }
                ui.dirty.insert(handle.id);
                ui.needs_redraw = true;
                blink_tick_multi(ui, handle);
            }
        });

        ui.listen(handle, move |e: &MouseScroll, ui: &mut Ui| {
            if let Some(input) = ui.get_mut_internal(handle) {
                let max_scroll = (input.total_visual_rows as f32 * input.line_height
                    - (input.h - input.padding * 2.0))
                    .max(0.0);
                input.scroll_y =
                    (input.scroll_y - e.y * input.line_height * 3.0).clamp(0.0, max_scroll);
                ui.needs_redraw = true;
            }
        });
    }

    fn update(&mut self, measurer: &mut TextMeasurer) {
        let t = std::time::Instant::now();

        let inner_w = self.w - self.padding * 2.0;
        let font_system = &mut measurer.font_system;

        // initialize buffer on first update
        if !self.initialized {
            self.editor.with_buffer_mut(|b| {
                b.set_metrics(font_system, Metrics::new(self.font_size, self.line_height));
                b.set_size(font_system, Some(inner_w), None);
            });
            self.editor.action(font_system, Action::Insert(' '));
            self.editor.action(font_system, Action::Backspace);
            self.editor.shape_as_needed(font_system, false);
            self.initialized = true;
        }

        // update size if changed
        self.editor.with_buffer_mut(|b| {
            b.set_size(font_system, Some(inner_w), None);
        });

        // process pending key events
        let keys: Vec<KeyPress> = self.pending_keys.drain(..).collect();
        for e in keys {
            let action = match e.key {
                Key::Enter => Some(Action::Enter),
                Key::Backspace => Some(Action::Backspace),
                Key::Delete => Some(Action::Delete),
                Key::Left => Some(Action::Motion(Motion::Left)),
                Key::Right => Some(Action::Motion(Motion::Right)),
                Key::Up => Some(Action::Motion(Motion::Up)),
                Key::Down => Some(Action::Motion(Motion::Down)),
                Key::Home => Some(Action::Motion(Motion::Home)),
                Key::End => Some(Action::Motion(Motion::End)),
                _ => {
                    if let Some(ch) = e.ch {
                        if !ch.is_control() {
                            Some(Action::Insert(ch))
                        } else {
                            None
                        }
                    } else {
                        None
                    }
                }
            };
            if let Some(action) = action {
                self.editor.action(font_system, action);
            }
        }

        // shape only what changed
        self.editor.shape_as_needed(font_system, false);

        // extract cursor position and layout info
        let cursor = self.editor.cursor();

        let mut visual_row = 0usize;
        let mut cursor_visual_row = 0usize;
        let mut cursor_x = 0.0f32;
        let mut total_rows = 0usize;

        self.editor.with_buffer(|b| {
            for (line_idx, line) in b.lines.iter().enumerate() {
                let layout = match line.layout_opt() {
                    Some(l) => l,
                    None => {
                        total_rows += 1;
                        continue;
                    }
                };
                for (vr_idx, layout_line) in layout.iter().enumerate() {
                    if line_idx == cursor.line {
                        // check if cursor is in this visual row
                        let glyph_count = layout_line.glyphs.len();
                        let row_start_glyph =
                            layout_line.glyphs.first().map(|g| g.start).unwrap_or(0);
                        let row_end_glyph = layout_line.glyphs.last().map(|g| g.end).unwrap_or(0);

                        let cursor_byte = cursor.index;
                        let in_this_row = if vr_idx + 1 == layout.len() {
                            cursor_byte >= row_start_glyph
                        } else {
                            cursor_byte >= row_start_glyph && cursor_byte < row_end_glyph
                        };

                        if in_this_row {
                            cursor_visual_row = visual_row;
                            // find x position of cursor in this visual row
                            cursor_x = layout_line
                                .glyphs
                                .iter()
                                .take_while(|g| g.start < cursor_byte)
                                .map(|g| g.x + g.w)
                                .last()
                                .unwrap_or(0.0);
                        }
                    }
                    visual_row += 1;
                    total_rows += 1;
                }
            }
        });

        self.cursor_x = cursor_x;
        self.cursor_visual_row = cursor_visual_row;
        self.total_visual_rows = total_rows.max(1);

        // scroll to keep cursor visible
        let inner_h = self.h - self.padding * 2.0;
        let cursor_top = self.cursor_visual_row as f32 * self.line_height;
        let cursor_bottom = cursor_top + self.line_height;
        if cursor_top < self.scroll_y {
            self.scroll_y = cursor_top;
        } else if cursor_bottom > self.scroll_y + inner_h {
            self.scroll_y = cursor_bottom - inner_h;
        }
        let max_scroll = (self.total_visual_rows as f32 * self.line_height - inner_h).max(0.0);
        self.scroll_y = self.scroll_y.clamp(0.0, max_scroll);
        println!("took {:?}", t.elapsed());
    }

    fn size(&self) -> (f32, f32) {
        (self.w, self.h)
    }
    fn position(&self) -> (f32, f32) {
        (self.x, self.y)
    }
    fn set_position(&mut self, x: f32, y: f32) {
        self.x = x;
        self.y = y;
    }
    fn set_size(&mut self, w: f32, h: f32) {
        self.w = w;
        self.h = h;
    }
    fn width_sizing(&self) -> &Size {
        &self.width
    }
    fn height_sizing(&self) -> &Size {
        &self.height
    }
    fn z(&self) -> i32 {
        self.z
    }

    fn render(&self, canvas: &mut Canvas) {
        // background
        canvas.draw_list.push_rect(RectDraw {
            x: canvas.x,
            y: canvas.y,
            w: self.w,
            h: self.h,
            color: self.background,
            radii: [0.0; 4],
            border_color: if self.focused {
                [0.0, 0.5, 1.0, 1.0]
            } else {
                [0.3, 0.3, 0.3, 1.0]
            },
            border_widths: [1.0; 4],
            rotate: canvas.rotate,
            scale_x: canvas.scale_x,
            scale_y: canvas.scale_y,
            opacity: canvas.opacity,
            clip: canvas.clip,
            z: canvas.z,
        });

        let clip = Some([canvas.x, canvas.y, self.w, self.h]);
        let inner_w = self.w - self.padding * 2.0;
        let mut visual_row = 0usize;

        // render each visual line
        self.editor.with_buffer(|b| {
            for line in b.lines.iter() {
                let layout = match line.layout_opt() {
                    Some(l) => l,
                    None => {
                        visual_row += 1;
                        return;
                    }
                };
                for layout_line in layout.iter() {
                    let row_y = canvas.y + self.padding + visual_row as f32 * self.line_height
                        - self.scroll_y;

                    if row_y + self.line_height >= canvas.y && row_y <= canvas.y + self.h {
                        // build text for this visual line
                        let text: String = layout_line
                            .glyphs
                            .iter()
                            .map(|g| &line.text()[g.start..g.end])
                            .collect();

                        if !text.is_empty() {
                            canvas.draw_list.push_text(TextDraw {
                                x: canvas.x + self.padding,
                                y: row_y,
                                w: inner_w,
                                h: self.line_height,
                                text,
                                size: self.font_size,
                                color: self.color,
                                weight: 400,
                                italic: false,
                                font_family: String::new(),
                                max_width: None,
                                line_height: Some(self.line_height),
                                letter_spacing: 0.0,
                                align: TextAlign::Left,
                                opacity: canvas.opacity,
                                clip,
                                rotate: canvas.rotate,
                                scale_x: canvas.scale_x,
                                scale_y: canvas.scale_y,
                                z: canvas.z + 1,
                                color_ranges: vec![],
                                background_ranges: vec![],
                                underline_ranges: vec![],
                                strikethrough_ranges: vec![],
                                weight_ranges: vec![],
                                italic_ranges: vec![],
                                font_family_ranges: vec![],
                            });
                        }
                    }
                    visual_row += 1;
                }
            }
        });

        // cursor
        if self.focused && self.cursor_visible {
            let cursor_y =
                canvas.y + self.padding + self.cursor_visual_row as f32 * self.line_height
                    - self.scroll_y;
            canvas.draw_list.push_rect(RectDraw {
                x: (canvas.x + self.padding + self.cursor_x).floor(),
                y: cursor_y,
                w: 1.5,
                h: self.line_height,
                color: [1.0, 1.0, 1.0, 1.0],
                radii: [0.0; 4],
                border_color: [0.0; 4],
                border_widths: [0.0; 4],
                rotate: canvas.rotate,
                scale_x: canvas.scale_x,
                scale_y: canvas.scale_y,
                opacity: canvas.opacity,
                clip,
                z: canvas.z + 2,
            });
        }
    }
}
